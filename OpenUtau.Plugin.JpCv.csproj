<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OpenUtauCore Condition="'$(OpenUtauCore)' == ''">C:\Path\To\OpenUtau\OpenUtau.Core.dll</OpenUtauCore>
    <AssemblyName>OpenUtau.Plugin.JpCv</AssemblyName>
    <RootNamespace>OpenUtau.Plugin.JpCv</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="JpCvPhonemizer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenUtau.Core">
      <HintPath>$(OpenUtauCore)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
